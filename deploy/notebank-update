import urllib.parse
import urllib.request

spec = importlib.util.spec_from_file_location('release_manifest', Path(__file__).with_name('release-manifest.py'))
manifest_module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(manifest_module)
version_tuple = manifest_module.version_tuple


class InvalidRelease(Exception):
    pass


class PreflightError(Exception):
    pass


@dataclass
class Config:
    api_url: str = 'https://api.github.com'
    token: str = ''
    public_key: Path = Path('/etc/notebank/release.pub')
    state_dir: Path = Path('/var/lib/notebank-update')
    binary: Path = Path('/usr/local/bin/notebank-server')
    backup_marker: Path = Path('/var/lib/notebank-backup/success.json')
    maintenance_lock: Path = Path('/run/lock/notebank-maintenance.lock')
    healthcheck_url: str = ''
    systemctl: str = '/usr/bin/systemctl'
    restic: str = '/usr/bin/restic'
    minisign: str = 'minisign'
    readiness_seconds: float = 60


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl)
        if target.scheme != 'https' or target.hostname not in {'release-assets.githubusercontent.com', 'objects.githubusercontent.com'}:
            raise PreflightError('unexpected download redirect')
        return urllib.request.Request(newurl, headers={'Accept': 'application/octet-stream'})


def download(url: str, config: Config, limit: int, accept: str = 'application/vnd.github+json') -> bytes:
    origin = urllib.parse.urlsplit(config.api_url)
    target = urllib.parse.urlsplit(url)
    if (target.scheme, target.netloc) != (origin.scheme, origin.netloc) or target.username or target.password:
        raise InvalidRelease('unexpected asset origin')
    if origin.scheme != 'https' and not (origin.scheme == 'http' and origin.hostname == '127.0.0.1'):
        raise PreflightError('HTTPS required')
    request = urllib.request.Request(url, headers={'Authorization': 'Bearer ' + config.token, 'Accept': accept,
                                                  'X-GitHub-Api-Version': '2022-11-28'})
    try:
        with urllib.request.build_opener(SafeRedirect()).open(request, timeout=30) as response:
            data = response.read(limit + 1)
        if len(data) > limit:
            raise InvalidRelease('release asset exceeds size limit')
        return data
    except (urllib.error.URLError, OSError, ValueError):
        raise PreflightError('release download failed') from None


def discover_release(api_url: str, token: str) -> dict | None:
    config = Config(api_url=api_url, token=token)
    candidates = []
    for page in range(1, 101):
        data = download(f'{api_url}/repos/DiAndyW/InfoBank/releases?per_page=100&page={page}', config, 4 * 1024 * 1024)
        try:
            releases = json.loads(data)
            if not isinstance(releases, list):
                raise ValueError()
            if not releases:
                break
            for release in releases:
                tag = release.get('tag_name', '')
                if release.get('draft') is False and release.get('prerelease') is False and tag.startswith('server-v'):
                    try:
                        version_tuple(tag[8:])
                    except ValueError:
                        continue
                    candidates.append(release)
        except (ValueError, AttributeError, TypeError):
            raise PreflightError('invalid release listing') from None
    else:
        raise PreflightError('release listing exceeds page limit')
    return max(candidates, key=lambda value: version_tuple(value['tag_name'][8:]), default=None)


def command(argv, timeout=120, env=None):
    try:
        return subprocess.run(list(map(str, argv)), check=True, capture_output=True, timeout=timeout, env=env).stdout
    except (subprocess.SubprocessError, OSError):
        raise PreflightError('administrative command failed') from None


def verify_release(release: dict, config: Config, staging: Path) -> dict:
    staging.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        assets = {}
        for asset in release['assets']:
            if asset['name'] in assets:
                raise InvalidRelease('duplicate release asset')
            assets[asset['name']] = asset['url']
        manifest = download(assets['manifest.json'], config, 65536, 'application/octet-stream')
        signature = download(assets['manifest.json.minisig'], config, 65536, 'application/octet-stream')
        (staging / 'manifest.json').write_bytes(manifest)
        (staging / 'manifest.json.minisig').write_bytes(signature)
        try:
            command([config.minisign, '-V', '-p', config.public_key, '-m', staging / 'manifest.json'])
        except PreflightError:
            raise InvalidRelease('release signature verification failed') from None
        value = manifest_module.parse_manifest(manifest)
        if release['tag_name'] != 'server-v' + value['version']:
            raise InvalidRelease('release tag does not match signed version')
        binary = download(assets[value['filename']], config, 128 * 1024 * 1024, 'application/octet-stream')
        if hashlib.sha256(binary).hexdigest() != value['sha256']:
            raise InvalidRelease('release binary checksum mismatch')
        (staging / value['filename']).write_bytes(binary)
        return dict(value, manifest_sha256=hashlib.sha256(manifest).hexdigest())
    except (KeyError, TypeError, ValueError):
        raise InvalidRelease('invalid or incomplete release') from None


def sync_directory(path: Path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_json(path: Path, value: dict):
    temporary = path.with_suffix('.tmp')
    with open(temporary, 'w', opener=lambda p, flags: os.open(p, flags, 0o600)) as output:
        json.dump(value, output, sort_keys=True)
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
    sync_directory(path.parent)


def read_state(config: Config, name: str):
    path = config.state_dir / (name + '.json')
    return json.loads(path.read_text()) if path.exists() else None


def remove_state(config: Config, name: str):
    (config.state_dir / (name + '.json')).unlink(missing_ok=True)
    sync_directory(config.state_dir)


def digest(path: Path) -> str:
    with path.open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def replace_binary(source: Path, destination: Path):
    fd, temporary = tempfile.mkstemp(prefix='.notebank-', dir=destination.parent)
    try:
        with os.fdopen(fd, 'wb') as output, source.open('rb') as input_file:
            shutil.copyfileobj(input_file, output)
            output.flush()
            os.fchmod(output.fileno(), 0o755)
            os.fsync(output.fileno())
        os.replace(temporary, destination)
        sync_directory(destination.parent)
    finally:
        Path(temporary).unlink(missing_ok=True)


def initialize(config: Config, version: str, commit: str):
    version_tuple(version)
    if not re.fullmatch('[0-9a-f]{40}', commit):
        raise PreflightError('invalid baseline commit')
    config.state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (config.state_dir / 'update.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if read_state(config, 'installed') or read_state(config, 'pending'):
            raise PreflightError('updater already initialized')
        atomic_json(config.state_dir / 'installed.json', dict(version=version, commit=commit, sha256=digest(config.binary)))


def validate_backup(config: Config, now: datetime):
    try:
        marker = json.loads(config.backup_marker.read_text())
        completed = marker['completed_at']
        if not completed.endswith('Z') or marker['format_version'] != 1:
            raise ValueError()
        age = (now - datetime.fromisoformat(completed.replace('Z', '+00:00'))).total_seconds()
        if not 0 <= age <= 86400 or not re.fullmatch('[0-9a-f]{64}', marker['snapshot_id']):
            raise ValueError()
        snapshots = json.loads(command([config.restic, 'snapshots', '--json', marker['snapshot_id']], timeout=120))
        if not any(value['id'] == marker['snapshot_id'] and value['hostname'] == 'notebank' for value in snapshots):
            raise ValueError()
    except (OSError, ValueError, KeyError, TypeError):
        raise PreflightError('successful backup within 24 hours required') from None


def listener_owned_by(pid: int, proc_root: Path = Path('/proc')) -> bool:
    process = proc_root / str(pid)
    try:
        inodes = set()
        for line in (process / 'net/tcp').read_text().splitlines()[1:]:
            fields = line.split()
            if fields[1] in {'0100007F:1F90', '00000000:1F90'} and fields[3] == '0A':
                inodes.add('socket:[' + fields[9] + ']')
        return any(os.readlink(fd) in inodes for fd in (process / 'fd').iterdir())
    except (OSError, IndexError):
        return False


def wait_ready(config: Config):
    stable_pid = None
    successes = 0
    deadline = time.monotonic() + config.readiness_seconds
    while time.monotonic() < deadline:
        try:
            command([config.systemctl, 'is-active', '--quiet', 'notebank.service'], timeout=5)
            pid = int(command([config.systemctl, 'show', '-p', 'MainPID', '--value', 'notebank.service'], timeout=5))
            if pid <= 0 or not os.path.samefile(Path('/proc') / str(pid) / 'exe', config.binary) or not listener_owned_by(pid):
                raise PreflightError('unexpected Server process')
            with urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3) as response:
                if response.status != 200:
                    raise PreflightError('Server is unhealthy')
                successes = successes + 1 if pid == stable_pid else 1
                stable_pid = pid
                if successes >= 3:
                    return
        except (PreflightError, OSError, ValueError, urllib.error.URLError):
            successes = 0
            stable_pid = None
        time.sleep(1)
    raise PreflightError('Server readiness check failed')


def restart(config: Config):
    command([config.systemctl, 'restart', 'notebank.service'], timeout=30)
    wait_ready(config)


def quarantine(config: Config, candidate: dict):
    failed = read_state(config, 'failed') or {}
    failed[candidate['version']] = candidate.get('manifest_sha256', 'invalid')
    atomic_json(config.state_dir / 'failed.json', failed)


def recover_pending(config: Config):
    pending = read_state(config, 'pending')
    if not pending:
        return
    quarantine(config, pending['candidate'])
    previous = config.state_dir / 'previous'
    if not previous.exists() or digest(previous) != pending['previous']['sha256']:
        raise PreflightError('previous binary unavailable; manual recovery required')
    current = digest(config.binary) if config.binary.exists() else None
    if current not in {pending['previous']['sha256'], pending['candidate'].get('sha256')}:
        raise PreflightError('installed binary identity is ambiguous; manual recovery required')
    replace_binary(previous, config.binary)
    restart(config)
    atomic_json(config.state_dir / 'installed.json', pending['previous'])
    remove_state(config, 'pending')


@dataclass
class UpdateResult:
    status: str
    release_version: str | None = None
    reason: str = ''


def run_update(config: Config, retry_version: str | None = None) -> UpdateResult:
    config.state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (config.state_dir / 'update.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return UpdateResult('busy')
        result = update_locked(config, retry_version)
        record_result(config, result)
        return result


def update_locked(config: Config, retry_version: str | None) -> UpdateResult:
    try:
        installed = read_state(config, 'installed')
        if not installed:
            raise PreflightError('initialize the installed baseline first')
        with config.maintenance_lock.open('a') as maintenance:
            fcntl.flock(maintenance, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if read_state(config, 'pending'):
                try:
                    recover_pending(config)
                except PreflightError:
                    return UpdateResult('rollback_failed', reason='interrupted update recovery failed')
                return UpdateResult('install_failed', reason='interrupted update rolled back')
        if digest(config.binary) != installed['sha256']:
            raise PreflightError('installed binary differs from recorded baseline')
        release = discover_release(config.api_url, config.token)
        if not release:
            return UpdateResult('idle')
        version = release['tag_name'][8:]
        if version_tuple(version) <= version_tuple(installed['version']):
            return UpdateResult('idle')
        failed = read_state(config, 'failed') or {}
        if version in failed and retry_version != version:
            return UpdateResult('blocked', version, 'release requires explicit retry')
        if retry_version and retry_version != version:
            raise PreflightError('retry must name the latest eligible release')
        with tempfile.TemporaryDirectory(prefix='download-', dir=config.state_dir) as directory:
            staging = Path(directory)
            try:
                candidate = verify_release(release, config, staging)
            except InvalidRelease:
                quarantine(config, dict(version=version))
                return UpdateResult('blocked', version, 'release verification failed')
            with config.maintenance_lock.open('a') as maintenance:
                fcntl.flock(maintenance, fcntl.LOCK_EX | fcntl.LOCK_NB)
                validate_backup(config, datetime.now(timezone.utc))
                replace_binary(config.binary, config.state_dir / 'previous')
                atomic_json(config.state_dir / 'pending.json', dict(previous=installed, candidate=candidate))
                try:
                    replace_binary(staging / candidate['filename'], config.binary)
                    restart(config)
                    atomic_json(config.state_dir / 'installed.json', candidate)
                    remove_state(config, 'pending')
                    return UpdateResult('installed', version)
                except (PreflightError, OSError):
                    quarantine(config, candidate)
                    try:
                        recover_pending(config)
                    except (PreflightError, OSError):
                        return UpdateResult('rollback_failed', version, 'installation and rollback failed')
                    return UpdateResult('install_failed', version, 'installation failed; previous binary restored')
    except BlockingIOError:
        return UpdateResult('preflight_failed', reason='backup maintenance is active')
    except (PreflightError, OSError, ValueError, KeyError, TypeError):
        return UpdateResult('preflight_failed', reason='update preflight failed; inspect configuration and backup status')


def record_result(config: Config, result: UpdateResult):
    if result.status == 'busy':
        return
    alert = read_state(config, 'alert')
    persistent = alert and alert['status'] in {'blocked', 'install_failed', 'rollback_failed'}
    if result.status == 'installed' or (result.status == 'idle' and not persistent):
        remove_state(config, 'alert')
        alert = None
    elif result.status not in {'idle', 'installed'} and (not persistent or result.status in {'install_failed', 'rollback_failed'}):
        alert = dict(status=result.status, version=result.release_version, reason=result.reason)
        atomic_json(config.state_dir / 'alert.json', alert)
    if config.healthcheck_url:
        try:
            target = urllib.parse.urlsplit(config.healthcheck_url)
            if target.scheme != 'https' or target.hostname != 'hc-ping.com' or target.query or target.fragment:
                raise ValueError()
            url = config.healthcheck_url.rstrip('/') + ('/fail' if alert else '')
            body = json.dumps(alert or dict(status=result.status, version=result.release_version)).encode()
            with urllib.request.build_opener(urllib.request.HTTPHandler(), urllib.request.HTTPSHandler(), NoRedirect()).open(
                    urllib.request.Request(url, data=body, method='POST'), timeout=10):
                pass
        except (OSError, ValueError, PreflightError, urllib.error.URLError):
            print('Updater monitoring delivery failed', file=sys.stderr)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        raise PreflightError('redirect refused')


def load_config() -> Config:
    token = Path('/etc/notebank/github-read-token').read_text().strip()
    if not token or '\n' in token:
        raise PreflightError('invalid read credential')
    return Config(token=token, healthcheck_url=os.environ.get('UPDATE_HEALTHCHECK_URL', ''), minisign='/usr/bin/minisign')


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('check')
    retry = sub.add_parser('retry')
    retry.add_argument('version')
    initial = sub.add_parser('initialize')
    initial.add_argument('--version', required=True)
    initial.add_argument('--commit', required=True)
    args = parser.parse_args(argv)
    if os.geteuid() != 0 or platform.system() != 'Linux' or platform.machine() not in {'aarch64', 'arm64'}:
        parser.error('run as root on the arm64 Linux VM')
    os.umask(0o077)
    try:
        config = load_config()
        if args.action == 'initialize':
            initialize(config, args.version, args.commit)
            return 0
        if args.action == 'retry':
            version_tuple(args.version)
        result = run_update(config, args.version if args.action == 'retry' else None)
        print(json.dumps(dict(status=result.status, version=result.release_version, reason=result.reason)))
        return 0 if result.status in {'idle', 'installed', 'busy'} else 1
    except (OSError, PreflightError, ValueError):
        print('Updater configuration or state error', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
