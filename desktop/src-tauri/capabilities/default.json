{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-get-settings",
    "allow-save-settings",
    "allow-double-click-interval-ms",
    "allow-trash-after-copy",
    "allow-set-trash-after-copy",
    "allow-list-topics",
    "allow-capture",
    "allow-move-item",
    "allow-edit-item",
    "allow-discard-item",
    "allow-resolve-conflict",
    "allow-trash-item",
    "allow-restore-item",
    "allow-nav-counts",
    "allow-create-topic",
    "allow-rename-topic",
    "allow-archive-topic",
    "allow-unarchive-topic",
    "allow-delete-topic",
    "allow-pick-files",
    "allow-stage-attachment-bytes",
    "allow-unstage-attachment",
    "allow-thumbnail",
    "allow-copy-item",
    "allow-open-attachment",
    "allow-reveal-attachment",
    "allow-list-items",
    "allow-search-items",
    "allow-sync-status",
    "allow-set-quick-capture-shortcut",
    "allow-set-quick-capture-on",
    "allow-autostart-on",
    "allow-set-autostart",
    "allow-dismiss-quick-capture",
    "allow-startup-error",
    "allow-show-data-folder",
    "allow-quit"
  ]
}
